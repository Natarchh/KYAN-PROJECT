        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\nskinparam DefaultTextAlignment center\n\ncloud \&quot;Internet / Public Network\&quot; as Internet\n\nnode \&quot;Client Device\\n&lt;&lt;device&gt;&gt;\&quot; as Client {\n  rectangle \&quot;Mobile OS\\n&lt;&lt;executionEnvironment&gt;&gt;\&quot; as ClientEnv {\n    artifact \&quot;hevy-mobile-app.apk\\n&lt;&lt;artifact&gt;&gt;\&quot; as App\n  }\n}\n\nnode \&quot;Web Server / Reverse Proxy\\n&lt;&lt;device&gt;&gt;\&quot; as WebServer {\n  rectangle \&quot;Nginx / Apache\\n&lt;&lt;executionEnvironment&gt;&gt;\&quot; as WebEnv {\n    artifact \&quot;nginx.conf\\n&lt;&lt;artifact&gt;&gt;\&quot; as NginxArt\n  }\n}\n\nnode \&quot;Cloud Application Server\\n&lt;&lt;device&gt;&gt;\&quot; as AppServer {\n  rectangle \&quot;Node.js / Docker Container\\n&lt;&lt;executionEnvironment&gt;&gt;\&quot; as AppEnv {\n    artifact \&quot;hevy-backend-api.jar\\n&lt;&lt;artifact&gt;&gt;\&quot; as API\n  }\n}\n\nnode \&quot;Cache &amp; Session Server\\n&lt;&lt;device&gt;&gt;\&quot; as CacheServer {\n  rectangle \&quot;Redis In-Memory\\n&lt;&lt;executionEnvironment&gt;&gt;\&quot; as CacheEnv {\n    artifact \&quot;redis-session.cache\\n&lt;&lt;artifact&gt;&gt;\&quot; as CacheArt\n  }\n}\n\nnode \&quot;Database Server\\n&lt;&lt;device&gt;&gt;\&quot; as DBServer {\n  rectangle \&quot;MySQL Database Engine\\n&lt;&lt;executionEnvironment&gt;&gt;\&quot; as DBEnv {\n    artifact \&quot;hevy_db_schema.sql\\n&lt;&lt;artifact&gt;&gt;\&quot; as Schema\n  }\n}\n\nInternet --&gt; Client : HTTPS (443)\nClient --&gt; WebServer : HTTPS Request\nWebServer --&gt; AppServer : HTTP (Port 8080)\nAppServer --&gt; CacheServer : TCP (Port 6379)\nAppServer --&gt; DBServer : TCP / JDBC (Port 3306)\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="xxNrjPEOel4VpdXOdnWk-1">
