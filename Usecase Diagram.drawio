        <mxCell id="Lp6v9F5hzl7RiW0mSU9p-63" parent="Lp6v9F5hzl7RiW0mSU9p-61" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;pointerEvents=1;align=left;strokeWidth=2;fontSize=16;" value="&lt;div style=&quot;&quot;&gt;Fitur ini memfasilitasi user ketika terdapat keadaan mendadak untuk merubah exercise.User&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;menukar urutan atau mengganti suatu gerakan latihan secara dinamis di tengah sesi yang sedang berlangsung. Fitur ini dirancang khusus sebagai solusi operasional di lapangan ketika alat &lt;i&gt;gym&lt;/i&gt; yang dituju sedang digunakan oleh orang lain&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;sup class=&quot;superscript&quot;&gt;&lt;/sup&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;. Sistem tidak hanya menukar nama, tetapi juga mengkalkulasi rekomendasi substitusi gerakan pengganti yang secara anatomis melatih kelompok otot yang sama agar program latihan user tidak kacau&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;sup class=&quot;superscript&quot;&gt;&lt;/sup&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="230" width="497" x="263" as="geometry">
            <mxRectangle height="230" width="497" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Lp6v9F5hzl7RiW0mSU9p-64" parent="Lp6v9F5hzl7RiW0mSU9p-54" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fixedHeader=1;strokeWidth=2;fontSize=16;" value="" vertex="1">
          <mxGeometry height="480" width="760" y="310" as="geometry" />
        </mxCell>
        <mxCell id="Lp6v9F5hzl7RiW0mSU9p-65" parent="Lp6v9F5hzl7RiW0mSU9p-64" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;pointerEvents=1;strokeWidth=2;fontSize=16;" value="&lt;b&gt;NORMAL COURSE&lt;/b&gt;" vertex="1">
          <mxGeometry height="480" width="263" as="geometry">
            <mxRectangle height="480" width="263" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Lp6v9F5hzl7RiW0mSU9p-66" parent="Lp6v9F5hzl7RiW0mSU9p-64" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;pointerEvents=1;align=left;strokeWidth=2;fontSize=16;" value="&lt;div style=&quot;&quot;&gt;&lt;ol&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;User mendapati alat &lt;/span&gt;&lt;i style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;gym&lt;/i&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt; sedang penuh saat berada di dalam alur sesi latihan.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;p id=&quot;p-rc_405b2a1f3f6011ef-382&quot;&gt;&lt;span&gt;User menekan tombol &quot;Swap Reorder Exercise&quot; pada antarmuka gerakan yang terhambat&lt;/span&gt;&lt;span&gt;&lt;sup class=&quot;superscript&quot;&gt;&lt;/sup&gt;&lt;/span&gt;&lt;span&gt;.&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p id=&quot;p-rc_405b2a1f3f6011ef-383&quot;&gt;&lt;span&gt;Sistem memunculkan jendela &lt;i&gt;overlay&lt;/i&gt; / &lt;i&gt;modal&lt;/i&gt; dan memanggil data dari pangkalan data&lt;/span&gt;&lt;span&gt;&lt;sup class=&quot;superscript&quot;&gt;&lt;/sup&gt;&lt;/span&gt;&lt;span&gt;.&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p id=&quot;p-rc_405b2a1f3f6011ef-384&quot;&gt;&lt;span&gt;Sistem memfilter dan menampilkan daftar rekomendasi gerakan pengganti berdasarkan target anatomi otot yang persis sama dengan gerakan awal&lt;/span&gt;&lt;span&gt;&lt;sup class=&quot;superscript&quot;&gt;&lt;/sup&gt;&lt;/span&gt;&lt;span&gt;.&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;User memilih satu gerakan alternatif dari daftar tersebut.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;Sistem memproses penukaran data&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;Sistem secara instan merender ulang antarmuka, menutup &lt;i&gt;modal&lt;/i&gt;, dan menyajikan blok pengisian &lt;i&gt;One-Tap Logging&lt;/i&gt; untuk gerakan baru tersebut.&lt;/p&gt;&lt;/li&gt;&lt;/ol&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="480" width="497" x="263" as="geometry">
            <mxRectangle height="480" width="497" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Lp6v9F5hzl7RiW0mSU9p-67" parent="Lp6v9F5hzl7RiW0mSU9p-54" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fixedHeader=1;strokeWidth=2;fontSize=16;" value="" vertex="1">
          <mxGeometry height="170" width="760" y="790" as="geometry" />
        </mxCell>
        <mxCell id="Lp6v9F5hzl7RiW0mSU9p-68" parent="Lp6v9F5hzl7RiW0mSU9p-67" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;pointerEvents=1;strokeWidth=2;fontSize=16;" value="&lt;b&gt;ALTERNATE COURSE&lt;/b&gt;" vertex="1">
          <mxGeometry height="170" width="263" as="geometry">
            <mxRectangle height="170" width="263" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Lp6v9F5hzl7RiW0mSU9p-69" parent="Lp6v9F5hzl7RiW0mSU9p-67" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;pointerEvents=1;align=left;strokeWidth=2;fontSize=16;" value="A.1.&amp;nbsp;&lt;span&gt;Jika user telah membuka jendela &lt;i&gt;modal Swap&lt;/i&gt; namun melihat alat &lt;i&gt;gym&lt;/i&gt; tersebut tiba-tiba kosong (atau berubah pikiran), user menekan tombol tutup (X) atau mengetuk area di luar &lt;i&gt;modal&lt;/i&gt;&lt;/span&gt;&lt;span&gt;&lt;sup class=&quot;superscript&quot;&gt;&lt;/sup&gt;&lt;/span&gt;&lt;span&gt;. Sistem akan menggugurkan proses penukaran, menutup &lt;i&gt;modal&lt;/i&gt;, dan mengembalikan antarmuka ke gerakan semula tanpa mengubah data sesi.&lt;/span&gt;" vertex="1">
          <mxGeometry height="170" width="497" x="263" as="geometry">
            <mxRectangle height="170" width="497" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
