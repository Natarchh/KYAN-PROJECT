        <mxCell id="Lp6v9F5hzl7RiW0mSU9p-78" parent="Lp6v9F5hzl7RiW0mSU9p-76" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;pointerEvents=1;fontStyle=1;align=left;strokeWidth=2;fontSize=16;" value="&lt;span style=&quot;font-weight: normal;&quot;&gt;&lt;span&gt;Diasumsikan bahwa arsitektur tabel&amp;nbsp;&lt;code&gt;Gerakan&lt;/code&gt; di dalam &lt;i&gt;Cloud Database&lt;/i&gt; telah terstruktur dengan atribut spesifik (seperti kolom &lt;code&gt;target_otot&lt;/code&gt;)&lt;/span&gt;&lt;span&gt;&lt;sup class=&quot;superscript&quot;&gt;&lt;/sup&gt;&lt;/span&gt;&lt;span&gt;. Adanya atribut klasifikasi ini mutlak diperlukan agar logika &lt;i&gt;array filter&lt;/i&gt; JavaScript di latar belakang dapat langsung mengenali dan menyodorkan rekomendasi substitusi otot yang akurat saat &lt;i&gt;modal&lt;/i&gt; penukaran dipanggil&lt;/span&gt;&lt;span&gt;&lt;sup class=&quot;superscript&quot;&gt;&lt;/sup&gt;&lt;/span&gt;&lt;span&gt;.&lt;/span&gt;&lt;/span&gt;" vertex="1">
