        <mxCell id="VgY2LB7neDugPZGGIzVC-63" parent="VgY2LB7neDugPZGGIzVC-56" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fixedHeader=1;strokeWidth=2;fontSize=16;" value="" vertex="1">
          <mxGeometry height="170" width="740" y="80" as="geometry" />
        </mxCell>
        <mxCell id="VgY2LB7neDugPZGGIzVC-64" parent="VgY2LB7neDugPZGGIzVC-63" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;pointerEvents=1;strokeWidth=2;fontSize=16;" value="&lt;b&gt;DESKRIPSI&lt;/b&gt;" vertex="1">
          <mxGeometry height="170" width="260" as="geometry">
            <mxRectangle height="170" width="260" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="VgY2LB7neDugPZGGIzVC-65" parent="VgY2LB7neDugPZGGIzVC-63" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;pointerEvents=1;align=left;strokeWidth=2;fontSize=16;" value="&lt;div style=&quot;&quot;&gt;&lt;span&gt;Fitur ini memungkinkan pengguna untuk memantau visualisasi metrik progres latihan jangka panjang (&lt;i&gt;Progressive Overload&lt;/i&gt;) dan riwayat pencapaian &lt;i&gt;Personal Record&lt;/i&gt; (PR)&lt;/span&gt;&lt;span&gt;&lt;sup class=&quot;superscript&quot;&gt;&lt;/sup&gt;&lt;/span&gt;&lt;span&gt;. Melalui antarmuka ini, pengguna dapat menganalisis data statistik sesi latihan secara dinamis dengan menerapkan berbagai kriteria filter spesifik, seperti berdasarkan metrik Volume, Durasi, atau Repetisi (Reps)&lt;/span&gt;&lt;span&gt;&lt;sup class=&quot;superscript&quot;&gt;&lt;/sup&gt;&lt;/span&gt;&lt;span&gt;.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="480" x="260" as="geometry">
            <mxRectangle height="170" width="480" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="VgY2LB7neDugPZGGIzVC-66" parent="VgY2LB7neDugPZGGIzVC-56" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fixedHeader=1;strokeWidth=2;fontSize=16;" value="" vertex="1">
          <mxGeometry height="630" width="740" y="250" as="geometry" />
        </mxCell>
        <mxCell id="VgY2LB7neDugPZGGIzVC-67" parent="VgY2LB7neDugPZGGIzVC-66" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;pointerEvents=1;strokeWidth=2;fontSize=16;" value="&lt;b&gt;NORMAL COURSE&lt;/b&gt;" vertex="1">
          <mxGeometry height="630" width="260" as="geometry">
            <mxRectangle height="630" width="260" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="VgY2LB7neDugPZGGIzVC-68" parent="VgY2LB7neDugPZGGIzVC-66" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;pointerEvents=1;align=left;strokeWidth=2;fontSize=16;" value="&lt;div style=&quot;&quot;&gt;&lt;ol&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;User mengeklik menu navigasi untuk membuka halaman Dashboard Analisis&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;sup class=&quot;superscript&quot;&gt;&lt;/sup&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;p id=&quot;p-rc_61a1a95f5189f12f-262&quot;&gt;&lt;span&gt;Sistem memasuki status &lt;i&gt;Loading&lt;/i&gt;&amp;nbsp;dan memunculkan indikator animasi tunggu di layar&lt;/span&gt;&lt;span&gt;&lt;sup class=&quot;superscript&quot;&gt;&lt;/sup&gt;&lt;/span&gt;&lt;span&gt;.&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p id=&quot;p-rc_61a1a95f5189f12f-263&quot;&gt;&lt;span&gt;Sistem memanggil API secara asinkronus ke backend&amp;nbsp;untuk menarik rekaman data statistik (seperti riwayat 3 bulan terakhir) dari &lt;i&gt;database&lt;/i&gt;&lt;/span&gt;&lt;span&gt;.&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p id=&quot;p-rc_61a1a95f5189f12f-264&quot;&gt;&lt;span&gt;Sistem merangkum data tersebut dan mengembalikannya dalam wujud objek JSON ke antarmuka user&lt;/span&gt;&lt;span&gt;&lt;sup class=&quot;superscript&quot;&gt;&lt;/sup&gt;&lt;/span&gt;&lt;span&gt;.&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p id=&quot;p-rc_61a1a95f5189f12f-265&quot;&gt;&lt;span&gt;Sistem menyelesaikan status memuat dan langsung me-&lt;i&gt;render&lt;/i&gt; grafik visual (&lt;i&gt;default Fast Track&lt;/i&gt;, misalnya metrik Volume) bagi user, memasuki status stabil (&lt;i&gt;Idle State&lt;/i&gt;)&lt;/span&gt;&lt;span&gt;&lt;sup class=&quot;superscript&quot;&gt;&lt;/sup&gt;&lt;/span&gt;&lt;span&gt;.&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p id=&quot;p-rc_61a1a95f5189f12f-266&quot;&gt;&lt;span&gt;User menekan salah satu tombol kategori filter (Durasi, Volume, atau Reps) yang ada di atas grafik&lt;/span&gt;&lt;span&gt;&lt;sup class=&quot;superscript&quot;&gt;&lt;/sup&gt;&lt;/span&gt;&lt;span&gt;.&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p id=&quot;p-rc_61a1a95f5189f12f-267&quot;&gt;&lt;span&gt;Sistem mengubah status antarmuka menjadi &lt;i&gt;recalculating&lt;/i&gt; (Kalkulasi Ulang) untuk mengolah besaran data sesuai dengan kriteria filter yang diklik&lt;/span&gt;&lt;span&gt;&lt;sup class=&quot;superscript&quot;&gt;&lt;/sup&gt;&lt;/span&gt;&lt;span&gt;.&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p id=&quot;p-rc_61a1a95f5189f12f-268&quot;&gt;&lt;span&gt;Sistem me-&lt;i&gt;render&lt;/i&gt; ulang dan menampilkan grafik batang baru yang telah disesuaikan dengan proporsi kalkulasi persentase data terfilter&lt;/span&gt;&lt;span&gt;&lt;sup class=&quot;superscript&quot;&gt;&lt;/sup&gt;&lt;/span&gt;&lt;span&gt;.&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ol&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="630" width="480" x="260" as="geometry">
            <mxRectangle height="630" width="480" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="VgY2LB7neDugPZGGIzVC-69" parent="VgY2LB7neDugPZGGIzVC-56" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fixedHeader=1;strokeWidth=2;fontSize=16;" value="" vertex="1">
          <mxGeometry height="170" width="740" y="880" as="geometry" />
        </mxCell>
        <mxCell id="VgY2LB7neDugPZGGIzVC-70" parent="VgY2LB7neDugPZGGIzVC-69" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;pointerEvents=1;strokeWidth=2;fontSize=16;" value="&lt;b&gt;ALTERNATE COURSE&lt;/b&gt;" vertex="1">
          <mxGeometry height="170" width="260" as="geometry">
            <mxRectangle height="170" width="260" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="VgY2LB7neDugPZGGIzVC-71" parent="VgY2LB7neDugPZGGIzVC-69" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;pointerEvents=1;align=left;strokeWidth=2;fontSize=16;" value="A.1. Jika sistem di sisi klien gagal menarik data akibat kegagalan di back end ataupun koneksi internet terputus, maka akan tampil pesan yang mengisyaratkan gagal mengambil data.&lt;div&gt;A.2.&amp;nbsp;Jika database belum memiliki riwayat rekaman sesi latihan apa pun dari user,sistem akan menampilkan ruang grafik kosong di layar&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="480" x="260" as="geometry">
            <mxRectangle height="170" width="480" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="VgY2LB7neDugPZGGIzVC-72" parent="VgY2LB7neDugPZGGIzVC-56" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fixedHeader=1;strokeWidth=2;fontSize=16;" value="" vertex="1">
          <mxGeometry height="150" width="740" y="1050" as="geometry" />
        </mxCell>
        <mxCell id="VgY2LB7neDugPZGGIzVC-73" parent="VgY2LB7neDugPZGGIzVC-72" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;pointerEvents=1;strokeWidth=2;fontSize=16;" value="&lt;b&gt;PRE-CONDITION&lt;/b&gt;" vertex="1">
          <mxGeometry height="150" width="260" as="geometry">
            <mxRectangle height="150" width="260" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="VgY2LB7neDugPZGGIzVC-74" parent="VgY2LB7neDugPZGGIzVC-72" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;pointerEvents=1;align=left;strokeWidth=2;fontSize=16;" value="&lt;span&gt;User tidak sedang berada di dalam alur Sesi Latihan Aktif, dan wajib sudah menyelesaikan minimal satu rangkaian sesi (&lt;i&gt;Finish Workout&lt;/i&gt;) sebelumnya, sehingga sistem memiliki entitas &lt;code&gt;SesiLatihan&lt;/code&gt; yang ditarik dari pangkalan data untuk divisualisasikan&lt;/span&gt;&lt;span&gt;&lt;sup class=&quot;superscript&quot;&gt;&lt;/sup&gt;&lt;/span&gt;&lt;span&gt;.&lt;/span&gt;" vertex="1">
          <mxGeometry height="150" width="480" x="260" as="geometry">
            <mxRectangle height="150" width="480" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="VgY2LB7neDugPZGGIzVC-75" parent="VgY2LB7neDugPZGGIzVC-56" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fixedHeader=1;strokeWidth=2;fontSize=16;" value="" vertex="1">
          <mxGeometry height="150" width="740" y="1200" as="geometry" />
        </mxCell>
        <mxCell id="VgY2LB7neDugPZGGIzVC-76" parent="VgY2LB7neDugPZGGIzVC-75" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;pointerEvents=1;strokeWidth=2;fontSize=16;" value="&lt;b&gt;POST-CONDITION&lt;/b&gt;" vertex="1">
          <mxGeometry height="150" width="260" as="geometry">
            <mxRectangle height="150" width="260" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="VgY2LB7neDugPZGGIzVC-77" parent="VgY2LB7neDugPZGGIzVC-75" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;pointerEvents=1;align=left;strokeWidth=2;fontSize=16;" value="&lt;span&gt;Sistem berhasil merender bagan statistik secara akurat berdasarkan proporsi matematika, mengubah status antarmuka kembali menjadi &lt;i&gt;Idle State&lt;/i&gt;, dan menunggu interaksi lanjutan dari pengguna (seperti menekan perpindahan halaman atau mengubah metrik filter kembali)&lt;/span&gt;&lt;span&gt;&lt;sup class=&quot;superscript&quot;&gt;&lt;/sup&gt;&lt;/span&gt;&lt;span&gt;.&lt;/span&gt;" vertex="1">
          <mxGeometry height="150" width="480" x="260" as="geometry">
            <mxRectangle height="150" width="480" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="VgY2LB7neDugPZGGIzVC-78" parent="VgY2LB7neDugPZGGIzVC-56" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fixedHeader=1;strokeWidth=2;fontSize=16;" value="" vertex="1">
          <mxGeometry height="140" width="740" y="1350" as="geometry" />
        </mxCell>
        <mxCell id="VgY2LB7neDugPZGGIzVC-79" parent="VgY2LB7neDugPZGGIzVC-78" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;pointerEvents=1;strokeWidth=2;fontSize=16;" value="&lt;b&gt;ASUMSI&lt;/b&gt;" vertex="1">
          <mxGeometry height="140" width="260" as="geometry">
            <mxRectangle height="140" width="260" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="VgY2LB7neDugPZGGIzVC-80" parent="VgY2LB7neDugPZGGIzVC-78" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;pointerEvents=1;fontStyle=1;align=left;strokeWidth=2;fontSize=16;" value="&lt;span style=&quot;font-weight: normal;&quot;&gt;&lt;span&gt;Diasumsikan user&amp;nbsp;tidak mengalami kendala jaringan dan layanan pangkalan data awan beroperasi normal, sehingga instruksi &lt;i&gt;Fetch API&lt;/i&gt; mampu menuntaskan resolusi permintaan data (JSON) dengan cepat tanpa mengalami &lt;i&gt;time-out&lt;/i&gt; jaringan&lt;/span&gt;&lt;span&gt;&lt;sup class=&quot;superscript&quot;&gt;&lt;/sup&gt;&lt;/span&gt;&lt;span&gt;.&lt;/span&gt;&lt;/span&gt;" vertex="1">
