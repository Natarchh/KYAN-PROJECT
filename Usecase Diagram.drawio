        <mxCell id="VgY2LB7neDugPZGGIzVC-112" parent="VgY2LB7neDugPZGGIzVC-110" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;pointerEvents=1;strokeWidth=2;fontSize=16;" value="Atlet" vertex="1">
          <mxGeometry height="40" width="420" x="260" as="geometry">
            <mxRectangle height="40" width="420" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="VgY2LB7neDugPZGGIzVC-113" parent="VgY2LB7neDugPZGGIzVC-106" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fixedHeader=1;strokeWidth=2;fontSize=16;" value="" vertex="1">
          <mxGeometry height="200" width="680" y="80" as="geometry" />
        </mxCell>
        <mxCell id="VgY2LB7neDugPZGGIzVC-114" parent="VgY2LB7neDugPZGGIzVC-113" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;pointerEvents=1;strokeWidth=2;fontSize=16;" value="&lt;b&gt;DESKRIPSI&lt;/b&gt;" vertex="1">
          <mxGeometry height="200" width="260" as="geometry">
            <mxRectangle height="200" width="260" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="VgY2LB7neDugPZGGIzVC-115" parent="VgY2LB7neDugPZGGIzVC-113" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;pointerEvents=1;align=left;strokeWidth=2;fontSize=16;" value="&lt;div style=&quot;&quot;&gt;&lt;span&gt;Fitur ini adalah alur administratif yang memungkinkan user untuk melakukan kustomisasi batasan waktu istirahat otomatis (&lt;i&gt;Auto-Rest Timer&lt;/i&gt;)&lt;/span&gt;&lt;span&gt;&lt;sup class=&quot;superscript&quot;&gt;&lt;/sup&gt;&lt;/span&gt;&lt;span&gt;. User dapat menetapkan durasi waktu yang spesifik dan berbeda untuk jenis latihan tertentu, misalnya mengatur waktu 90 detik untuk gerakan &lt;i&gt;compound&lt;/i&gt; dan 60 detik untuk gerakan isolasi&lt;/span&gt;&lt;span&gt;&lt;sup class=&quot;superscript&quot;&gt;&lt;/sup&gt;&lt;/span&gt;&lt;span&gt;. Pengaturan ini dibuat untuk menyelesaikan masalah inkonsistensi waktu istirahat akibat penghitungan manual di lapangan&lt;/span&gt;&lt;span&gt;&lt;sup class=&quot;superscript&quot;&gt;&lt;/sup&gt;&lt;/span&gt;&lt;span&gt;.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="420" x="260" as="geometry">
            <mxRectangle height="200" width="420" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="VgY2LB7neDugPZGGIzVC-116" parent="VgY2LB7neDugPZGGIzVC-106" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fixedHeader=1;strokeWidth=2;fontSize=16;" value="" vertex="1">
          <mxGeometry height="390" width="680" y="280" as="geometry" />
        </mxCell>
        <mxCell id="VgY2LB7neDugPZGGIzVC-117" parent="VgY2LB7neDugPZGGIzVC-116" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;pointerEvents=1;strokeWidth=2;fontSize=16;" value="&lt;b&gt;NORMAL COURSE&lt;/b&gt;" vertex="1">
          <mxGeometry height="390" width="260" as="geometry">
            <mxRectangle height="390" width="260" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="VgY2LB7neDugPZGGIzVC-118" parent="VgY2LB7neDugPZGGIzVC-116" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;pointerEvents=1;align=left;strokeWidth=2;fontSize=16;" value="&lt;div style=&quot;&quot;&gt;&lt;ol&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;User mengisi form rest timer di salah satu exercise di dalam routine.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;Sistem menampilkan kolom isian (&lt;i&gt;input&lt;/i&gt;) yang berisi angka durasi istirahat yang sedang aktif.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p id=&quot;p-rc_4df68b3eef111441-321&quot;&gt;&lt;span&gt;User memasukkan angka durasi baru (misalnya 90 detik) lalu menekan tombol aksi untuk menyimpan&lt;/span&gt;&lt;span&gt;&lt;sup class=&quot;superscript&quot;&gt;&lt;/sup&gt;&lt;/span&gt;&lt;span&gt;.&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p id=&quot;p-rc_4df68b3eef111441-322&quot;&gt;&lt;span&gt;Sistem memvalidasi angka yang dimasukkan untuk memastikan batas waktu sesuai aturan (misalnya tidak boleh kurang dari 10 detik)&lt;/span&gt;&lt;span&gt;&lt;sup class=&quot;superscript&quot;&gt;&lt;/sup&gt;&lt;/span&gt;&lt;span&gt;.&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p id=&quot;p-rc_4df68b3eef111441-323&quot;&gt;&lt;span&gt;Sistem menyimpan nilai durasi baru tersebut secara permanen ke dalam memori aplikasi&lt;/span&gt;&lt;span&gt;&lt;sup class=&quot;superscript&quot;&gt;&lt;/sup&gt;&lt;/span&gt;&lt;span&gt;.&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ol&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="390" width="420" x="260" as="geometry">
            <mxRectangle height="390" width="420" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="VgY2LB7neDugPZGGIzVC-119" parent="VgY2LB7neDugPZGGIzVC-106" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fixedHeader=1;strokeWidth=2;fontSize=16;" value="" vertex="1">
          <mxGeometry height="240" width="680" y="670" as="geometry" />
        </mxCell>
        <mxCell id="VgY2LB7neDugPZGGIzVC-120" parent="VgY2LB7neDugPZGGIzVC-119" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;pointerEvents=1;strokeWidth=2;fontSize=16;" value="&lt;b&gt;ALTERNATE COURSE&lt;/b&gt;" vertex="1">
          <mxGeometry height="240" width="260" as="geometry">
            <mxRectangle height="240" width="260" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="VgY2LB7neDugPZGGIzVC-121" parent="VgY2LB7neDugPZGGIzVC-119" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;pointerEvents=1;align=left;strokeWidth=2;fontSize=16;" value="A.1.&amp;nbsp;&lt;span&gt;Jika user mencoba menyimpan angka durasi yang tidak logis (seperti huruf, angka negatif, atau durasi di bawah batas minimal 10 detik), sistem akan menolak proses penyimpanan, mempertahankan angka sebelumnya, dan memunculkan pesan peringatan validasi di layar&lt;/span&gt;&lt;span&gt;&lt;sup class=&quot;superscript&quot;&gt;&lt;/sup&gt;&lt;/span&gt;&lt;span&gt;.&lt;/span&gt;&lt;div&gt;A.2.&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Jika user telah mengetik angka baru tetapi memilih untuk menekan area di luar form rest timer tersebut, maka sistem menyimpan&amp;nbsp;&lt;/span&gt;&lt;i style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;input&lt;/i&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt; sementara tersebut dan durasi nya jadi berubah.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="240" width="420" x="260" as="geometry">
            <mxRectangle height="240" width="420" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="VgY2LB7neDugPZGGIzVC-122" parent="VgY2LB7neDugPZGGIzVC-106" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fixedHeader=1;strokeWidth=2;fontSize=16;" value="" vertex="1">
          <mxGeometry height="86" width="680" y="910" as="geometry" />
        </mxCell>
