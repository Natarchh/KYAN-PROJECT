        <mxCell id="VgY2LB7neDugPZGGIzVC-89" parent="VgY2LB7neDugPZGGIzVC-88" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;pointerEvents=1;strokeWidth=2;fontSize=16;" value="&lt;b&gt;DESKRIPSI&lt;/b&gt;" vertex="1">
          <mxGeometry height="190" width="263" as="geometry">
            <mxRectangle height="190" width="263" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="VgY2LB7neDugPZGGIzVC-90" parent="VgY2LB7neDugPZGGIzVC-88" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;pointerEvents=1;align=left;strokeWidth=2;fontSize=16;" value="&lt;div style=&quot;&quot;&gt;&lt;span&gt;Fitur ini memungkinkan user untuk membuka pustaka referensi terintegrasi yang memuat panduan postur atau teknik eksekusi latihan fisik&lt;/span&gt;&lt;span&gt;&lt;sup class=&quot;superscript&quot;&gt;&lt;/sup&gt;&lt;/span&gt;&lt;span&gt;. Akses ini dirancang untuk menyajikan instruksi visual secara instan kepada user yang lupa akan teknik gerakan yang benar, sehingga berperan krusial dalam membantu user menghindari risiko cedera otot saat berlatih di &lt;i&gt;gym&lt;/i&gt;&lt;/span&gt;&lt;span&gt;&lt;sup class=&quot;superscript&quot;&gt;&lt;/sup&gt;&lt;/span&gt;&lt;span&gt;.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="190" width="497" x="263" as="geometry">
            <mxRectangle height="190" width="497" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="VgY2LB7neDugPZGGIzVC-91" parent="VgY2LB7neDugPZGGIzVC-81" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fixedHeader=1;strokeWidth=2;fontSize=16;" value="" vertex="1">
          <mxGeometry height="390" width="760" y="270" as="geometry" />
        </mxCell>
        <mxCell id="VgY2LB7neDugPZGGIzVC-92" parent="VgY2LB7neDugPZGGIzVC-91" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;pointerEvents=1;strokeWidth=2;fontSize=16;" value="&lt;b&gt;NORMAL COURSE&lt;/b&gt;" vertex="1">
          <mxGeometry height="390" width="263" as="geometry">
            <mxRectangle height="390" width="263" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="VgY2LB7neDugPZGGIzVC-93" parent="VgY2LB7neDugPZGGIzVC-91" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;pointerEvents=1;align=left;strokeWidth=2;fontSize=16;" value="&lt;div style=&quot;&quot;&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;ol&gt;&lt;li&gt;&lt;p id=&quot;p-rc_935ad1d613c9e8cd-298&quot;&gt;&lt;span&gt;User mengeklik ikon pintasan &lt;i&gt;Exercise Library&lt;/i&gt;&amp;nbsp;di area dashboard&lt;/span&gt;&lt;span&gt;.&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;Sistem menampilkan daftar pustaka gerakan.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;User memilih satu spesifik gerakan dari daftar tersebut.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p id=&quot;p-rc_935ad1d613c9e8cd-299&quot;&gt;&lt;span&gt;Sistem memunculkan antarmuka detail yang berisi informasi target anatomi otot yang bekerja dan langsung memutar klip video panduan postur berformat GIF &lt;i&gt;looping&lt;/i&gt;&lt;/span&gt;&lt;span&gt;&lt;sup class=&quot;superscript&quot;&gt;&lt;/sup&gt;&lt;/span&gt;&lt;span&gt;.&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p id=&quot;p-rc_935ad1d613c9e8cd-300&quot;&gt;&lt;span&gt;User menekan tombol tutup atau kembali untuk keluar dari pustaka visual tersebut&lt;/span&gt;&lt;span&gt;&lt;sup class=&quot;superscript&quot;&gt;&lt;/sup&gt;&lt;/span&gt;&lt;span&gt;.&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ol&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="390" width="497" x="263" as="geometry">
            <mxRectangle height="390" width="497" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="VgY2LB7neDugPZGGIzVC-94" parent="VgY2LB7neDugPZGGIzVC-81" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fixedHeader=1;strokeWidth=2;fontSize=16;" value="" vertex="1">
          <mxGeometry height="180" width="760" y="660" as="geometry" />
