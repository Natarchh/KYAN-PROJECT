        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nactor Admin\nboundary \&quot;FormTransaksiUI\&quot; as UI\ncontrol \&quot;TransaksiController\&quot; as Controller\nentity \&quot;UnitRumah\&quot; as Unit\nentity \&quot;Transaksi\&quot; as Trx\n\nAdmin -&gt; UI : bukaMenuTransaksi()\nactivate UI\nUI --&gt; Admin : tampilkanForm()\ndeactivate UI\n\nAdmin -&gt; UI : inputDataTransaksi(pelanggan, unit, sales, fee)\nactivate UI\nUI -&gt; Controller : prosesTransaksi(data)\nactivate Controller\n\nController -&gt; Unit : cekKetersediaan(id_unit)\nactivate Unit\nUnit --&gt; Controller : return ketersediaan\ndeactivate Unit\n\nalt Ketersediaan == true\n    Controller -&gt; Trx : simpanTransaksi(data)\n    activate Trx\n    Trx --&gt; Controller : return success\n    deactivate Trx\n    \n    Controller -&gt; Unit : updateStatusUnit(id_unit, \&quot;Terjual\&quot;)\n    activate Unit\n    Unit --&gt; Controller : return success\n    deactivate Unit\n    \n    Controller --&gt; UI : tampilkanPesanSukses()\nelse Ketersediaan == false\n    Controller --&gt; UI : tampilkanPesanError()\nend\ndeactivate Controller\nUI --&gt; Admin : Tampilkan Pesan\ndeactivate UI\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="yJ6w5c1V76Gb8SkYVsRn-1">
