        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n|Administrator|\nstart\n:Memilih Menu Angsuran Pembayaran;\n\n|Sistem|\n:Menampilkan Daftar Transaksi Berstatus Belum Lunas;\n\n|Administrator|\n:Memilih Aksi (Catat Angsuran / Cetak Kwitansi);\nif (Aksi yang Dipilih?) then (Catat Angsuran)\n  :Memilih ID Transaksi;\n  :Mengisi Nominal Bayar, Metode Bayar, dan Keterangan;\n  :Menekan Tombol Simpan;\n  |Sistem|\n  :Menyimpan Data Angsuran Pembayaran;\n  :Menghitung Sisa Tagihan Transaksi;\n  if (Sisa Tagihan = 0?) then (Ya)\n    :Mengubah Status Transaksi menjadi Lunas;\n  else (Tidak)\n    :Mempertahankan Status Belum Lunas;\n  endif\nelse (Cetak Kwitansi)\n  |Sistem|\n  :Menampilkan Preview Kwitansi Angsuran;\n  |Administrator|\n  :Mencetak Kwitansi Angsuran;\nendif\nstop\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="cphi1VHwfw7r6kxTj5_4-1">
