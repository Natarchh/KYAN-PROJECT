  <diagram id="F3DYgwsNnrsRxIlROyo8" name="Mengelola Data Master">
    <mxGraphModel dx="1179" dy="1067" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n|Administrator|\nstart\n:Memilih Menu Data Master\\n(Perumahan / Tipe Rumah / Unit Rumah / Pelanggan / Sales);\n\n|Sistem|\n:Menampilkan Tabel Data Master dan Form Input;\n\n|Administrator|\n:Memilih Aksi Pengelolaan;\nif (Aksi yang Dipilih?) then (Tambah / Edit)\n  :Mengisi atau Mengubah Data pada Form;\n  :Menekan Tombol Simpan;\n  |Sistem|\n  :Memvalidasi Kelengkapan Data;\n  if (Data Lengkap?) then (Ya)\n    :Menyimpan / Memperbarui Data ke Database;\n    :Memperbarui Tampilan Tabel Data;\n  else (Tidak)\n    :Menampilkan Pesan Data Belum Lengkap;\n  endif\nelseif (Hapus) then\n  |Sistem|\n  :Menghapus Data Terpilih dari Database;\n  :Memperbarui Tampilan Tabel Data;\nelse (Mencetak Data)\n  |Sistem|\n  :Menampilkan Preview Cetak Data Master;\n  |Administrator|\n  :Mencetak Dokumen Data Master;\nendif\nstop\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="PCr0Fxiy5k26xGfGcvkn-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
