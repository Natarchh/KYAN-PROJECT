        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n|Administrator|\nstart\n:Memilih Menu Booking Fee;\n\n|Sistem|\n:Menampilkan Data Booking dan Unit Berstatus Tersedia;\n\n|Administrator|\n:Memilih Aksi (Tambah / Edit / Batal / Cetak Kwitansi);\nif (Aksi yang Dipilih?) then (Simpan Booking Baru)\n  :Memilih Pelanggan, Unit Rumah, dan Sales;\n  :Mengisi Nominal Booking Fee;\n  :Menekan Tombol Simpan;\n  |Sistem|\n  :Memvalidasi Data Booking;\n  if (Data Valid?) then (Ya)\n    :Menyimpan Data Booking Fee;\n    :Mengubah Status Unit Rumah menjadi Booking;\n  else (Tidak)\n    :Menampilkan Pesan Kesalahan;\n  endif\nelseif (Batalkan Booking) then\n  |Sistem|\n  :Mengubah Status Booking menjadi Batal;\n  :Mengembalikan Status Unit Rumah menjadi Tersedia;\nelse (Cetak Kwitansi)\n  |Sistem|\n  :Menampilkan Preview Kwitansi Booking Fee;\n  |Administrator|\n  :Mencetak Kwitansi Booking;\nendif\nstop\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="NACwss_U7aBGdPkhEOID-1">
