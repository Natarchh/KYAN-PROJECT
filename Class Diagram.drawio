        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nclass User {\n  - id_user : int\n  - username : varchar\n  - password : varchar\n  + login()\n  + logout()\n}\n\nclass Perumahan {\n  - id_perumahan : varchar\n  - nama_perumahan : varchar\n  - lokasi : varchar\n  + tambah()\n  + edit()\n  + hapus()\n}\n\nclass TipeRumah {\n  - id_tipe : varchar\n  - id_perumahan : varchar\n  - nama_tipe : varchar\n  - luas_bangunan : int\n  - luas_tanah : int\n  - harga : double\n  + tambah()\n  + edit()\n  + hapus()\n}\n\nclass UnitRumah {\n  - id_unit : varchar\n  - id_tipe : varchar\n  - blok_nomor : varchar\n  - status : varchar\n  + updateStatus()\n}\n\nclass Pelanggan {\n  - id_pelanggan : varchar\n  - nama_pelanggan : varchar\n  - no_telp : varchar\n  - alamat : text\n  + tambah()\n}\n\nclass Sales {\n  - id_sales : varchar\n  - nama_sales : varchar\n  - no_telp : varchar\n  + tambah()\n}\n\nclass Transaksi {\n  - no_transaksi : varchar\n  - id_pelanggan : varchar\n  - id_unit : varchar\n  - id_sales : varchar\n  - tgl_transaksi : date\n  - booking_fee : double\n  - total_harga : double\n  + simpanTransaksi()\n  + cetakNota()\n}\n\nPerumahan \&quot;1\&quot; -- \&quot;1..*\&quot; TipeRumah\nTipeRumah \&quot;1\&quot; -- \&quot;1..*\&quot; UnitRumah\nPelanggan \&quot;1\&quot; -- \&quot;0..*\&quot; Transaksi\nSales \&quot;1\&quot; -- \&quot;0..*\&quot; Transaksi\nUnitRumah \&quot;1\&quot; -- \&quot;0..1\&quot; Transaksi\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Q8BOS22zSga_g1q3FlsE-1">
